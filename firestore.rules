rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Los cursos viven en lib/cursos.ts: nadie escribe documentos de cursos.
    // Las reseñas son la subcolección cursos/{cursoId}/resenas/{uid}.
    match /cursos/{cursoId} {
      allow write: if false;

      match /resenas/{uid} {
        // La reseña es válida si tiene exactamente estos campos y tipos.
        function datosValidos(d) {
          return d.keys().hasOnly(['puntaje', 'texto', 'autor', 'creadaEn'])
            && d.keys().hasAll(['puntaje', 'texto', 'autor', 'creadaEn'])
            && d.puntaje is int && d.puntaje >= 1 && d.puntaje <= 5
            && d.texto is string && d.texto.size() <= 500
            && d.autor is string && d.autor.size() <= 80
            && d.creadaEn is timestamp;
        }

        function esElPropietario() {
          return request.auth != null && request.auth.uid == uid;
        }

        allow read: if true;

        allow create: if esElPropietario()
          && datosValidos(request.resource.data)
          && request.resource.data.creadaEn == request.time;

        allow update: if esElPropietario()
          && datosValidos(request.resource.data)
          && request.resource.data.creadaEn == resource.data.creadaEn;

        allow delete: if esElPropietario();
      }
    }

    // Denegación predeterminada para cualquier otra ruta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
